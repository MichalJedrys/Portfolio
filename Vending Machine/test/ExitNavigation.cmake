foreach(input IN ITEMS "0\ninvalid\n" "11\nHardPassword\n3\ninvalid\n")
    set(input_file "${CMAKE_CURRENT_BINARY_DIR}/vending-exit-input.txt")
    file(WRITE "${input_file}" "${input}")
    execute_process(COMMAND "${PROGRAM}" INPUT_FILE "${input_file}"
        OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE result TIMEOUT 5)
    if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "shutting down")
        message(FATAL_ERROR "Exit did not complete successfully: ${result}\n${errors}")
    endif()
    string(REGEX MATCHALL "Available options:" menus "${output}")
    list(LENGTH menus menu_count)
    if(NOT menu_count EQUAL 1 OR output MATCHES "Error:")
        message(FATAL_ERROR "Input was consumed after selecting exit: ${output}")
    endif()
endforeach()
file(REMOVE "${input_file}")
